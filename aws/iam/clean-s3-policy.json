{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRaw",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mypipe-data-rg/raw/*"
    },
    {
      "Sid": "WriteCleaned",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::mypipe-data-rg/cleaned/*"
    }
  ]
}

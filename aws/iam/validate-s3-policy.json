{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCleaned",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mypipe-data-rg/cleaned/*"
    },
    {
      "Sid": "WriteValidatedAndInvalid",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::mypipe-data-rg/validated/*",
        "arn:aws:s3:::mypipe-data-rg/invalid/*"
      ]
    }
  ]
}
